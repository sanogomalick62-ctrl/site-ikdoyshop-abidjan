# Copy this file to .env and fill in real values before running in production

# Port the server listens on
PORT=3000

# Secret used to sign admin login sessions - MUST be replaced with a real random
# value before deploying. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start in production (NODE_ENV=production) if this is
# left as the placeholder below, missing, or shorter than 32 characters.
JWT_SECRET=change-this-to-a-long-random-string

# Allowed cross-origin domains for the API, comma-separated (e.g. if you ever
# call this API from a different domain than the one serving the site itself).
# Same-origin requests always work regardless of this setting. Leave empty/unset
# for a normal single-domain deployment - it's not needed.
# ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Used only the very first time you run "npm run seed" (creates the first admin account)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=ChangeMe123!

NODE_ENV=development

# Optional - only needed if you're deploying with a mounted persistent disk
# (e.g. Render's Starter plan and up). Leave these two commented out /
# unset for normal local use - they default to server/data and server/uploads.
# DATA_DIR=/var/data/db
# UPLOADS_DIR=/var/data/uploads
